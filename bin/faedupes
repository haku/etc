#!/usr/bin/env python

from collections import namedtuple
from dataclasses import dataclass
import os
import pathlib
import sqlite3
import hashlib

DB_PATH = "/home/haku/.config/faedupes/db"

DbFile = namedtuple('DbFile',
    field_names=['path', 'size', 'ctime', 'hash'],
    defaults=[None])

@dataclass
class Stats:
  files_added: int = 0
  files_updated: int = 0

def dbcon():
  return sqlite3.connect(DB_PATH, autocommit=True)

def db_mktables():
  pathlib.Path(DB_PATH).parent.mkdir(parents=True, exist_ok=True)
  with dbcon() as db:
    db.execute("CREATE TABLE IF NOT EXISTS files("
               "path TEXT PRIMARY KEY NOT NULL,"
               "size INTEGER NOT NULL,"
               "ctime INTEGER NOT NULL,"
               "hash TEXT)")

def db_check_files_exist(db, dbfs):
  keep = []
  to_rm = []
  for dbf in dbfs:
    if os.path.lexists(dbf.path):
      keep += [dbf]
    else:
      to_rm += (dbf.path,)
  if len(to_rm) > 0:
    db.executemany("DELETE FROM files WHERE path=?", to_rm)
  return keep

def db_get_file(db, path):
  rows = list(db.execute(
      "SELECT path, size, ctime, hash FROM files"
      f" WHERE path = ?", (str(path),)))
  if len(rows) == 0:
    return None
  elif len(rows) > 1:
    raise Error(f"Multiple rows for: {path}")
  row = rows[0]
  return DbFile(row[0], row[1], row[2], row[3])

def db_add_files(db, paths_stats):
  rows = [(str(path), stat.st_size, stat.st_ctime)
          for path, stat in paths_stats]
  db.executemany(
      "INSERT INTO files (path, size, ctime) VALUES (?, ?, ?)", rows)

def db_update_files(db, paths_stats):
  rows = [(stat.st_size, stat.st_ctime, str(path))
          for path, stat in paths_stats]
  db.executemany(
      "UPDATE files SET size=?, ctime=?, hash=null WHERE path=?", rows)

def db_files_with_same_size(db):
  rows = list(db.execute(
      "SELECT path, size, ctime, hash FROM files"
      " WHERE size IN (SELECT size FROM files"
      "  GROUP BY size HAVING COUNT(*) > 1)"))
  return [DbFile(r[0], r[1], r[2], r[3]) for r in rows]

def db_files_with_same_hash_in_dir(db, root):
  like = str(root) + "/"
  like = like.replace("\\", "\\\\")
  like = like.replace("%", r"\%")
  like = like.replace("_", r"\_")
  like += "%"
  rows = list(db.execute(
      "SELECT path, size, ctime, hash FROM files"
      " WHERE path LIKE ? ESCAPE ? AND hash IN"
      " (SELECT hash FROM files"
      "  WHERE hash IS NOT NULL"
      "  GROUP BY hash HAVING COUNT(*) > 1)", (like, "\\")))
  return [DbFile(r[0], r[1], r[2], r[3]) for r in rows]

def update_files(db, paths, stats):
  to_add = []
  to_update = []

  for path in paths:
    stat = path.stat()
    dbf = db_get_file(db, path)
    if dbf is None:
      to_add += [(path, stat)]
    elif dbf.size != stat.st_size or dbf.ctime != stat.st_ctime:
      to_update += [(path, stat)]

  db_add_files(db, to_add)
  db_update_files(db, to_update)

  stats.files_added += len(to_add)
  stats.files_updated += len(to_update)

def sha1(path):
  with open(path, 'rb', buffering=0) as f:
    return hashlib.file_digest(f, 'sha1').hexdigest()

def update_hashes(db, dbfs):
  to_hash = []
  for dbf in dbfs:
    stat = pathlib.Path(dbf.path).stat()
    if (dbf.hash is None
        or dbf.size != stat.st_size
        or dbf.ctime != stat.st_ctime):
      to_hash += (dbf,)

  if len(to_hash) > 0:
    print(f"To hash: {len(to_hash)}")
    rows = []
    # TODO batch so less work is lost if cancelled?
    for dbf in to_hash:
      rows += [(sha1(dbf.path), dbf.path)]
    db.executemany(
        "UPDATE files SET hash=? WHERE path=?", rows)

def walk_files(start):
  stats = Stats()
  with dbcon() as db:
    for root, dirs, files in start.walk():
      paths = [start / root / f for f in files]
      # TODO bigger DB batches?
      update_files(db, paths, stats)

  if stats.files_added or stats.files_updated:
    print(f"Files added:   {stats.files_added}")
    print(f"Files updated: {stats.files_updated}")

def find_dupes(root):
  with dbcon() as db:
    size_dupes = db_files_with_same_size(db)
    size_dupes = db_check_files_exist(db, size_dupes)
    update_hashes(db, size_dupes)
    hash_dupes = db_files_with_same_hash_in_dir(db, root)

  if hash_dupes:
    print(f"Hash dupes:    {len(hash_dupes)}")
  for dbf in hash_dupes:
    print(dbf.path)

if __name__ == '__main__':
  db_mktables()

  pwd = pathlib.Path(".").resolve(strict=True)
  walk_files(pwd)
  find_dupes(pwd)
